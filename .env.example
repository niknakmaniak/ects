# ECTS — variables d'environnement (copier vers .env)

# Base
ECTS_ENV=development
ECTS_DATA_DIR=./data
ECTS_REPO_ROOT=.
DATABASE_URL=sqlite:///./data/ects.db
# DATABASE_URL=postgresql+psycopg://ects:ects@postgres:5432/ects

# API
ECTS_API_HOST=0.0.0.0
ECTS_API_PORT=8080
ECTS_API_TOKEN=change-me-vps-token
ECTS_GPU_WORKER_TOKEN=change-me-gpu-token

# Panel web (http://IP:8080/panel)
ECTS_PANEL_USER=admin
ECTS_PANEL_PASSWORD=change-me-panel
ECTS_PANEL_SECRET=

# Jobs
ECTS_DEFAULT_DEADLINE_HOUR=8
ECTS_LEASE_MINUTES=5

# Google Drive — compte de service JSON (jamais dans git, voir credentials/)
# Partager les dossiers Drive avec l'email du service account (lecteur ou editeur)
GOOGLE_SERVICE_ACCOUNT_FILE=/repo/credentials/google-service-account.json
DRIVE_INBOX_FOLDER_ID=
DRIVE_PROCESSING_FOLDER_ID=
DRIVE_FINISHED_FOLDER_ID=
DRIVE_ERROR_FOLDER_ID=

# LLM cloud (texte uniquement — audio jamais envoyé)
LLM_PROVIDER=moonshot
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=
LLM_MODEL=kimi-k3
LLM_MONTHLY_BUDGET_EUR=999

# Git — commit + push auto depuis le VPS apres chaque seance
GIT_REMOTE_URL=https://github.com/niknakmaniak/ects.git
GIT_USER_NAME=ECTS Bot
GIT_USER_EMAIL=ects@bot.local
GIT_AUTO_PUSH=true
GIT_GITHUB_TOKEN=

# GPU worker (ASUS) — URL publique du VPS
GPU_WORKER_URL=http://148.113.242.154:8080
WHISPER_MODEL=large-v3

# LoRA — nombre de séances validées par matière avant entraînement GPU
LORA_MIN_SESSIONS=3
LORA_OUTPUT_DIR=./adapters
